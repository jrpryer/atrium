    { "id": "votive-candle", "name": "Votive Candle", "kind": "reagent", "traits": ["waxen", "warm"], "poolEnergy": { "light": 2, "heat": 1 },
      "description": "A small clear candle that burns, impossibly, under water." },

    { "id": "distilled-dew", "name": "Distilled Dew", "kind": "reagent", "traits": ["cold"], "poolEnergy": { "light": 0, "heat": -3 },
      "description": "Dew run through the still until only the cold is left." },
    { "id": "spirit-of-cinders", "name": "Spirit of Cinders", "kind": "reagent", "traits": ["warm"], "poolEnergy": { "light": 1, "heat": 3 },
      "description": "The warmth of a cinder, distilled. The jar is uncomfortable to hold." },
    { "id": "clear-spirit", "name": "Clear Spirit", "kind": "food", "traits": ["clean", "food"], "foodValue": 70,
      "description": "Stillwater twice distilled. Fish find it bracing." }
  ]
}
