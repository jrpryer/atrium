// Apothecary elements. Once discovered an element is known for good and never runs out.
// "portable": elements that can be bottled into the satchel. "poolEnergy": what a bottle does in a pool.
{
  "items": [
    { "id": "spring-water", "name": "Spring Water", "kind": "ingredient", "traits": ["wet", "cold"],
      "description": "Clear, cold water from the Atrium's spring. The start of most things." },
    { "id": "hearth-ash", "name": "Hearth Ash", "kind": "ingredient", "traits": ["ashen"],
      "description": "Soft grey ash from Tamsin's hearth. It gets everywhere." },
    { "id": "patience", "name": "Patience", "kind": "ingredient", "traits": ["slow"], "portable": false,
      "description": "An hour-candle marked in thumb-widths. Most things worth making need some. It doesn't keep in a jar." },

    { "id": "steam", "name": "Steam", "kind": "ingredient", "traits": ["wet", "warm"], "portable": false,
      "description": "Warm water climbing. It won't stay in a jar long enough to carry." },
    { "id": "lye", "name": "Lye", "kind": "ingredient", "traits": ["wet", "biting"],
      "description": "A biting liquor of water and ash. It eats rust and grease and patience, in that order." },
    { "id": "stillwater", "name": "Stillwater", "kind": "ingredient", "traits": ["wet", "still"], "poolEnergy": { "light": 0, "heat": -1 },
      "description": "Water left alone until it forgot how to move. Cool to the touch." },
    { "id": "loam", "name": "Loam", "kind": "ingredient", "traits": ["earthy"],
      "description": "Ash given time becomes earth again. It smells of rain." },
    { "id": "cinder", "name": "Cinder", "kind": "reagent", "traits": ["ashen", "warm"], "poolEnergy": { "light": 1, "heat": 2 },
      "description": "A coal of ash that won't quite go out. Warm through the jar." },

    { "id": "morning-mist", "name": "Morning Mist", "kind": "ingredient", "traits": ["wet"], "portable": false,
      "description": "Steam that has settled down and thought about things." },
    { "id": "dew", "name": "Dew", "kind": "ingredient", "traits": ["wet", "cold"],
      "description": "Mist that has given up and sat on the grass. Bright, tiny, cold." },
    { "id": "potash", "name": "Potash", "kind": "ingredient", "traits": ["salt"],
      "description": "White crust left when lye is boiled dry. Good for glass and soap." },
    { "id": "mud", "name": "Mud", "kind": "ingredient", "traits": ["earthy", "wet"],
      "description": "Loam and water. Every child's first alchemy." },
    { "id": "clay", "name": "Clay", "kind": "ingredient", "traits": ["earthy"],
      "description": "Mud that waited. It holds a shape now." },
    { "id": "charcoal", "name": "Charcoal", "kind": "reagent", "traits": ["ashen"], "poolEnergy": { "light": -1, "heat": 0 },
      "description": "A cinder that went patiently out. Drinks light a little." },

    { "id": "green-shoot", "name": "Green Shoot", "kind": "ingredient", "traits": ["green"],
      "description": "Loam and stillwater, and something green has decided to happen." },
    { "id": "reed", "name": "Reed", "kind": "ingredient", "traits": ["green"],
      "description": "A shoot given patience grows tall and hollow and whispery." },
    { "id": "reed-fibre", "name": "Reed Fibre", "kind": "ingredient", "traits": ["green", "binding"],
      "description": "Reed beaten soft under the pestle into long pale threads." },
    { "id": "reed-twine", "name": "Reed Twine", "kind": "ingredient", "traits": ["binding"],
      "description": "Fibre twisted slowly into a strong grey cord." },
    { "id": "reed-seed", "name": "Reed Seed", "kind": "ingredient", "traits": ["green"],
      "description": "A reed left long enough goes to seed: small, dark, oily grains." },
    { "id": "pressed-oil", "name": "Pressed Oil", "kind": "ingredient", "traits": ["oily"],
      "description": "Golden oil ground from reed seed. It burns clean and slow." },
    { "id": "fired-clay", "name": "Fired Clay", "kind": "ingredient", "traits": ["vessel"],
      "description": "Clay that has been through the flame and come out a pot, more or less." },
    { "id": "grog-sand", "name": "Grog Sand", "kind": "ingredient", "traits": ["gritty"],
      "description": "Fired clay ground back down to a fine red sand." },
    { "id": "lamp-glass", "name": "Lamp Glass", "kind": "ingredient", "traits": ["glass"], "poolEnergy": { "light": 1, "heat": 0 },
      "description": "Greenish glass, a little bubbled, good enough for a lamp chimney. It catches the light." },
    { "id": "lampblack-ink", "name": "Lampblack Ink", "kind": "reagent", "traits": ["dark-ink"], "poolEnergy": { "light": -2, "heat": 0 },
      "description": "Charcoal ground fine in stillwater. Black enough to darken a pool." },
    { "id": "soap", "name": "Soap", "kind": "ingredient", "traits": ["clean"],
      "description": "Lye and oil, which ought to hate each other, getting along." },
    { "id": "reed-meal", "name": "Reed Meal", "kind": "food", "traits": ["food"], "foodValue": 100,
      "description": "Reed and loam ground together. Fish go silly for it." },
    { "id": "brine", "name": "Brine", "kind": "ingredient", "traits": ["salt", "wet"],
      "description": "Potash dissolved in spring water. Tastes of tears." },
    { "id": "cold-brine", "name": "Cold Brine", "kind": "reagent", "traits": ["salt", "cold"], "poolEnergy": { "light": 0, "heat": -2 },
      "description": "Brine left to brood. It stays colder than the room, out of spite." },

    { "id": "shrine-wax", "name": "Shrine-Wax", "kind": "ingredient", "traits": ["waxen", "votive"],
      "description": "Hard, clear wax of the kind the Hallows shrines burn, scraped carefully from the edges of the vow-token." },
    { "id": "waxed-reed-pouch", "name": "Waxed Reed Pouch", "kind": "ingredient", "traits": ["vessel", "binding", "waxen"],
