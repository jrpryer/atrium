// The Apothecary discovery tree. Inputs are an order-independent set; "tool" is optional.
// The validator rejects cycles and warns about recipes that can never be reached.
{
  "recipes": [
    { "id": "r-steam", "inputs": ["spring-water"], "tool": "bunsen-burner", "output": "steam",
      "text": "You warm the water until it remembers it can climb." },
    { "id": "r-lye", "inputs": ["spring-water", "hearth-ash"], "output": "lye",
      "text": "The ash sinks, the water clouds, and when it clears it bites the tip of your finger." },
    { "id": "r-stillwater", "inputs": ["spring-water", "patience"], "output": "stillwater",
      "text": "You set the water by and wait. And wait. When you look again it has gone perfectly, peculiarly still." },
    { "id": "r-loam", "inputs": ["hearth-ash", "patience"], "output": "loam",
      "text": "Left alone, the ash darkens and softens and smells, suddenly, of rain. Earth again." },
    { "id": "r-cinder", "inputs": ["hearth-ash"], "tool": "bunsen-burner", "output": "cinder",
      "text": "In the flame the ash draws itself together into a glowing coal that refuses, politely, to go out." },

    { "id": "r-mist", "inputs": ["steam", "patience"], "output": "morning-mist",
      "text": "The steam slows, spreads, and hangs over the bench like a morning that hasn't decided yet." },
    { "id": "r-dew", "inputs": ["morning-mist", "stillwater"], "output": "dew",
      "text": "The mist meets the stillwater and gives up, settling on the glass in a thousand tiny beads." },
    { "id": "r-potash", "inputs": ["lye"], "tool": "bunsen-burner", "output": "potash",
      "text": "The lye boils down and down until only a white crust is left in the dish." },
    { "id": "r-mud", "inputs": ["loam", "spring-water"], "output": "mud",
      "text": "Mud. Gloriously, unmistakably, mud." },
    { "id": "r-clay", "inputs": ["mud", "patience"], "output": "clay",
      "text": "The mud firms and smooths and, when you press a thumb in it, keeps the print." },
    { "id": "r-charcoal", "inputs": ["cinder", "patience"], "output": "charcoal",
      "text": "The cinder dims slowly, slowly, and goes out black and light and faintly glittering." },

    { "id": "r-shoot", "inputs": ["loam", "stillwater"], "output": "green-shoot",
      "text": "A pale green thread unfolds from the loam, as if it had been waiting to be asked." },
    { "id": "r-reed", "inputs": ["green-shoot", "patience"], "output": "reed",
      "text": "The shoot grows tall and hollow and starts, very quietly, to whisper." },
    { "id": "r-fibre", "inputs": ["reed"], "tool": "mortar-and-pestle", "output": "reed-fibre",
      "text": "Under the pestle the reed comes apart into long, soft, pale threads." },
    { "id": "r-twine", "inputs": ["reed-fibre", "patience"], "output": "reed-twine",
      "text": "You twist the fibre, and twist it again, and it becomes a cord strong enough to hang a lantern from." },
    { "id": "r-seed", "inputs": ["reed", "patience"], "output": "reed-seed",
      "text": "Left long enough, the reed bows its head and drops a scatter of small dark seeds." },
    { "id": "r-oil", "inputs": ["reed-seed"], "tool": "mortar-and-pestle", "output": "pressed-oil",
      "text": "The seeds crack, and a thread of golden oil runs down the side of the mortar." },
    { "id": "r-fired-clay", "inputs": ["clay"], "tool": "bunsen-burner", "output": "fired-clay",
      "text": "The clay rings when you tap it now. A pot, more or less." },
    { "id": "r-grog", "inputs": ["fired-clay"], "tool": "mortar-and-pestle", "output": "grog-sand",
      "text": "You grind the pot back down to a fine red sand. Tamsin says this is perfectly normal and not at all a waste." },
    { "id": "r-glass", "inputs": ["grog-sand", "potash"], "tool": "bunsen-burner", "output": "lamp-glass",
      "text": "The sand and potash slump together in the heat and run, and cool into a lump of greenish, bubbled glass." },
    { "id": "r-ink", "inputs": ["charcoal", "stillwater"], "tool": "mortar-and-pestle", "output": "lampblack-ink",
      "text": "The charcoal gives up all its darkness into the stillwater. The ink is black as a closed eye." },
    { "id": "r-soap", "inputs": ["lye", "pressed-oil"], "output": "soap",
      "text": "Lye and oil, which ought to hate each other, decide to get along." },
    { "id": "r-meal", "inputs": ["reed", "loam"], "tool": "mortar-and-pestle", "output": "reed-meal",
      "text": "A green-brown meal that smells, Tamsin says, exactly like a fish's idea of a party." },
    { "id": "r-brine", "inputs": ["potash", "spring-water"], "output": "brine",
      "text": "The crust melts into the water and the water tastes of tears." },
    { "id": "r-cold-brine", "inputs": ["brine", "patience"], "output": "cold-brine",
      "text": "The brine broods. When you touch the jar it is colder than the room, out of spite." },

    { "id": "r-pouch", "inputs": ["reed-twine", "shrine-wax"], "output": "waxed-reed-pouch",
      "text": "You weave the twine tight and seal every gap with shrine-wax. The pouch would hold anything. Smoke, even." },
    { "id": "r-candle", "inputs": ["shrine-wax", "reed-twine"], "tool": "bunsen-burner", "output": "votive-candle",
      "text": "You warm the wax around a twist of twine. The little candle burns clear and steady, even when you dip it in water." },

    { "id": "r-distilled-dew", "inputs": ["dew"], "tool": "spirit-still", "output": "distilled-dew",
      "text": "The still runs the dew through and through until only the cold is left, beading the glass." },
    { "id": "r-spirit-cinders", "inputs": ["cinder", "stillwater"], "tool": "spirit-still", "output": "spirit-of-cinders",
      "text": "The coil glows; what drips out is the colour of a coal and makes the jar uncomfortable to hold." },
    { "id": "r-clear-spirit", "inputs": ["stillwater"], "tool": "spirit-still", "output": "clear-spirit",
      "text": "Twice distilled, the stillwater comes over so clear you can only find it by its cold." }
  ]
}
