  "tools": [
    { "id": "mortar-and-pestle", "name": "Mortar & Pestle", "locale": "apothecary", "kind": "fixed", "verb": "grind",
      "description": "Heavy grey stone, worn smooth by Corran's grandmother's grandmother." },
    { "id": "bunsen-burner", "name": "Bunsen Burner", "locale": "apothecary", "kind": "fixed", "verb": "warm",
      "description": "A brass burner with a blue, patient flame." },
    { "id": "weighing-scales", "name": "Weighing Scales", "locale": "apothecary", "kind": "fixed", "verb": "weigh",
