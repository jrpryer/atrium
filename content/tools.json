      "availableWhen": { "capability": "apothecary.distill" },
      "description": "A coil of lamp-glass on a clay stand, installed on the end of Tamsin's bench." },

    { "id": "magnifying-glass", "name": "Magnifying Glass", "locale": "sanctum", "kind": "fixed", "verb": "examine",
      "description": "The Keeper's glass, on a long brass chain. It makes small things patient enough to be read." },
    { "id": "reconstitution-circle", "name": "Reconstitution Circle", "locale": "sanctum", "kind": "fixed", "verb": "restore",
