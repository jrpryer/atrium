<Project Sdk="Microsoft.NET.Sdk">
  <!-- Iteration 2 front end: a standalone 3D "lantern-lit diorama" built on raylib (Raylib-cs, Zlib licence).
       Presentation only: every rule lives in Atrium.Core. Delete this project to return to the terminal-only build. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Atrium.Diorama</RootNamespace>
    <AssemblyName>AtriumDiorama</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Atrium.Core\Atrium.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Models built by tools/blender (iteration 3); the hub falls back to built-in shapes for any that are missing. -->
    <None Include="..\..\art\models\*.glb" LinkBase="models" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
